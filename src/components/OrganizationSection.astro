---
interface Props { page: string; organizations: Array<any>; }
const { page, organizations } = Astro.props;
---
<section id="organization" class={`${page} border-b border-zinc-200`}><div class="px-6 sm:px-8 py-8 sm:py-10"><div class="experience-header"><h2 class="text-lg sm:text-2xl font-semibold tracking-tight text-zinc-950">Organization Experience</h2><p class="text-zinc-500 text-xs sm:text-sm">Leadership and organizational involvement.</p></div><div class="experience-list">{organizations.map((item) => (<article class="experience-entry flex items-start gap-4 sm:gap-5"><div class="shrink-0 w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center"><img src={item.logo} alt={`${item.organization} logo`} loading="lazy" class="w-full h-full object-contain" /></div><div class="flex-1 min-w-0"><div class="experience-topline"><div class="flex items-center gap-2"><h3>{item.organization}</h3>{item.hasGallery && <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-zinc-100 text-zinc-600 border border-zinc-200"><span>Photos</span></span>}</div><strong>{item.period}</strong></div><div class="flex items-center justify-between gap-2 mt-1"><div class="experience-role">{item.role}</div>{item.hasGallery && <button type="button" class="open-gallery-trigger text-xs font-semibold text-zinc-900 hover:text-zinc-600 dark:text-zinc-100 dark:hover:text-zinc-400 transition-colors inline-flex items-center gap-1 cursor-pointer bg-transparent border-0 p-0" data-gallery-id={item.id}><span>View documentation</span><span aria-hidden="true">&rarr;</span></button>}</div></div></article>))}</div></div></section>
