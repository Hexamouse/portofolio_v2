---
interface Props { page: string; projects: Array<{ title: string; description: string; tech: string[]; link: string }>; github: string; }
const { page, projects, github } = Astro.props;
---
<section id="projects" class={`${page} border-b border-zinc-200`}>
  <div class="px-6 sm:px-8 py-8 sm:py-10 space-y-8"><div class="flex items-end justify-between gap-4"><div class="space-y-1.5"><h2 class="text-lg sm:text-2xl font-semibold tracking-tight text-zinc-950">Selected Projects</h2><p class="text-zinc-500 text-xs sm:text-sm">A few products and applications I have built.</p></div><a href={`${github}?tab=repositories`} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-medium text-zinc-600 hover:text-zinc-950 transition-colors shrink-0 group/seemore pb-1"><span>See more</span><span aria-hidden="true">&rarr;</span></a></div><div class="grid grid-cols-1 md:grid-cols-2 gap-5">{projects.map((project) => (<div class="group border border-zinc-200 bg-white p-5 sm:p-6 shadow-sm hover:shadow-md hover:border-zinc-300 transition-all duration-200 flex flex-col justify-between"><div class="space-y-3"><h3 class="text-sm sm:text-base font-semibold tracking-tight text-zinc-950 group-hover:text-zinc-700 transition-colors">{project.title}</h3><p class="text-xs sm:text-sm text-zinc-500 leading-relaxed">{project.description}</p></div><div class="mt-6 space-y-4"><div class="flex flex-wrap gap-1.5">{project.tech.map((item) => <span class="text-[10px] sm:text-[11px] font-mono px-2 py-0.5 bg-zinc-100 text-zinc-600 border border-zinc-200/70">{item}</span>)}</div><a href={project.link} class="inline-flex items-center gap-1 text-[11px] sm:text-xs font-semibold text-zinc-900 hover:text-zinc-600 transition-colors">View Project <span aria-hidden="true">&rarr;</span></a></div></div>))}</div></div>
</section>
