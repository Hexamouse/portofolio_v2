---
interface Props { organizations: Array<any>; }
const { organizations } = Astro.props;
---
<div id="gallery-modal" class="fixed inset-0 z-100 hidden items-center justify-center p-4 sm:p-6 bg-black/75 backdrop-blur-sm transition-opacity duration-200" role="dialog" aria-modal="true" aria-labelledby="gallery-modal-title"><div class="relative w-full max-w-4xl max-h-[90vh] flex flex-col bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-xl shadow-2xl overflow-hidden" id="gallery-modal-content"><div class="flex items-center justify-between px-5 sm:px-6 py-4 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/50"><div><h3 id="gallery-modal-title" class="text-base sm:text-lg font-semibold text-zinc-950 dark:text-zinc-100">Gallery</h3><p id="gallery-modal-subtitle" class="text-xs text-zinc-500 dark:text-zinc-400">Photographic documentation and organizational activities &mdash; click any photo to enlarge.</p></div><button type="button" id="close-gallery-btn" class="p-1.5 rounded-lg text-zinc-500 hover:text-zinc-950 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer" aria-label="Close gallery"><span aria-hidden="true">&times;</span></button></div><div class="p-5 sm:p-6 overflow-y-auto max-h-[calc(90vh-80px)]"><div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div></div></div></div>
<div id="lightbox-modal" class="fixed inset-0 z-120 hidden items-center justify-center p-3 sm:p-6 bg-black/90 backdrop-blur-md" role="dialog" aria-modal="true"><div class="relative max-w-5xl max-h-[92vh] flex flex-col items-center"><button type="button" id="close-lightbox-btn" class="absolute -top-10 right-0 sm:-right-10 text-white/80 hover:text-white p-2 transition-colors cursor-pointer" aria-label="Close enlarged image">&times;</button><img id="lightbox-img" src="" alt="" class="max-w-full max-h-[80vh] object-contain rounded-lg shadow-2xl border border-white/10" /><p id="lightbox-caption" class="mt-3 text-sm text-zinc-300 font-medium text-center px-4"></p></div></div>
<script is:inline define:vars={{ organizations }}>
  const setupGalleryModal = () => {
    const galleryModal = document.getElementById("gallery-modal"); const galleryTitle = document.getElementById("gallery-modal-title"); const gallerySubtitle = document.getElementById("gallery-modal-subtitle"); const galleryGrid = document.getElementById("gallery-grid"); const lightboxModal = document.getElementById("lightbox-modal"); const lightboxImg = document.getElementById("lightbox-img"); const lightboxCaption = document.getElementById("lightbox-caption");
    if (!galleryModal || !galleryGrid) return;
    const closeLightbox = () => { lightboxModal?.classList.add("hidden"); lightboxModal?.classList.remove("flex"); };
    const openLightbox = (url, caption) => { if (!lightboxModal || !lightboxImg) return; lightboxImg.src = url; lightboxImg.alt = caption; if (lightboxCaption) lightboxCaption.textContent = caption; lightboxModal.classList.remove("hidden"); lightboxModal.classList.add("flex"); };
    const closeGallery = () => { galleryModal.classList.add("hidden"); galleryModal.classList.remove("flex"); document.body.style.overflow = ""; };
    document.querySelectorAll(".open-gallery-trigger").forEach((trigger) => trigger.addEventListener("click", () => { const org = organizations.find((item) => item.id === trigger.getAttribute("data-gallery-id")); if (!org?.photos) return; if (galleryTitle) galleryTitle.textContent = `${org.organization} Gallery`; if (gallerySubtitle) gallerySubtitle.textContent = `Photographic documentation and organizational activities — click any photo to enlarge (${org.photos.length} photos).`; galleryGrid.innerHTML = org.photos.map((photo, index) => `<button type="button" class="gallery-thumbnail-btn group relative aspect-4/3 rounded-lg overflow-hidden border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-950 hover:shadow-md focus:outline-hidden focus:ring-2 focus:ring-zinc-400 transition-all text-left cursor-pointer" data-full-img="${photo.url}" data-caption="${photo.caption || `${org.organization} Documentation #${index + 1}`}"><img src="${photo.url}" alt="${photo.caption || org.organization}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" loading="lazy" /></button>`).join(""); galleryGrid.querySelectorAll(".gallery-thumbnail-btn").forEach((button) => button.addEventListener("click", () => { const url = button.getAttribute("data-full-img"); if (url) openLightbox(url, button.getAttribute("data-caption") || ""); })); galleryModal.classList.remove("hidden"); galleryModal.classList.add("flex"); document.body.style.overflow = "hidden"; }));
    document.getElementById("close-gallery-btn")?.addEventListener("click", closeGallery); galleryModal.addEventListener("click", (event) => { if (event.target === galleryModal) closeGallery(); }); document.getElementById("close-lightbox-btn")?.addEventListener("click", closeLightbox); lightboxModal?.addEventListener("click", (event) => { if (event.target === lightboxModal) closeLightbox(); }); document.addEventListener("keydown", (event) => { if (event.key === "Escape") { if (lightboxModal && !lightboxModal.classList.contains("hidden")) closeLightbox(); else if (!galleryModal.classList.contains("hidden")) closeGallery(); } });
  };
  setupGalleryModal(); document.addEventListener("astro:page-load", setupGalleryModal);
</script>
