---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, banner, bannerAlt, tags } = post.data;
const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a
  href={`/blog/${post.id}`}
  class="group border border-zinc-200 bg-white shadow-sm hover:shadow-md hover:border-zinc-300 transition-all duration-200 flex flex-col overflow-hidden"
>
  {
    banner ? (
      <img
        src={banner}
        alt={bannerAlt ?? title}
        loading="lazy"
        class="aspect-[16/9] w-full object-cover border-b border-zinc-200"
      />
    ) : (
      <div
        aria-hidden="true"
        class="aspect-[16/9] w-full border-b border-zinc-200 bg-zinc-100 flex items-center justify-center"
      >
        <span class="text-2xl font-bold tracking-tight text-zinc-300">
          {title.charAt(0)}
        </span>
      </div>
    )
  }
  <div class="p-5 sm:p-6 flex flex-col flex-1">
    <p class="text-[11px] sm:text-xs text-zinc-500">{formattedDate}</p>
    <h3
      class="mt-2 text-sm sm:text-base font-semibold tracking-tight text-zinc-950 group-hover:text-zinc-700 transition-colors line-clamp-2"
    >
      {title}
    </h3>
    <p class="mt-2 text-xs sm:text-sm text-zinc-500 leading-relaxed line-clamp-3">
      {description}
    </p>
    <div class="mt-auto pt-6 space-y-4">
      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <span class="text-[10px] sm:text-[11px] font-mono px-2 py-0.5 bg-zinc-100 text-zinc-600 border border-zinc-200/70">
                {tag}
              </span>
            ))}
          </div>
        )
      }
      <span
        class="inline-flex items-center gap-1 text-[11px] sm:text-xs font-semibold text-zinc-900 group-hover:text-zinc-600 transition-colors"
      >
        Read Post <span aria-hidden="true">&rarr;</span>
      </span>
    </div>
  </div>
</a>
