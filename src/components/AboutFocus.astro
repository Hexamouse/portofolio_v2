---
interface Props { page: string; interests: string[]; }
const { page, interests } = Astro.props;
---
<section class={`${page} border-b border-zinc-200`}><div class="px-6 sm:px-8 py-8 sm:py-10 space-y-6"><div class="space-y-1.5"><h2 class="text-lg sm:text-2xl font-semibold tracking-tight text-zinc-950">Areas of Focus</h2><p class="text-zinc-500 text-xs sm:text-sm">Core technical domains and subjects I actively pursue.</p></div><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">{interests.map((interest) => <div class="border border-zinc-200 bg-white p-4 shadow-2xs hover:border-zinc-300 transition-colors"><span class="text-xs sm:text-sm font-medium text-zinc-800">{interest}</span></div>)}</div></div></section>
