---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PagePreloader from "../../components/PagePreloader.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getCollection } from "astro:content";
import { profile } from "../../data/portfolio";

const page = "w-full md:w-[80%] mx-auto";
const container = `${page} px-4 sm:px-6 md:px-8`;

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog | dzikri</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("theme") || "dark";
      document.documentElement.dataset.theme = savedTheme;
    </script>
  </head>
  <body
    class="bg-white text-zinc-950 antialiased selection:bg-zinc-900 selection:text-white font-sans"
  >
    <PagePreloader />
    <div
      aria-hidden="true"
      class="page-line pointer-events-none fixed inset-y-0 left-[10%] w-px bg-zinc-200 z-60"
    ></div>
    <div
      aria-hidden="true"
      class="page-line pointer-events-none fixed inset-y-0 right-[10%] w-px bg-zinc-200 z-60"
    ></div>
    <Header container={container} activeNav="blog" />
    <main>
      <section class={`${page} border-b border-zinc-200`}>
        <div class="px-6 sm:px-8 py-8 sm:py-10 space-y-8">
          <div class="space-y-1.5">
            <h1
              class="text-lg sm:text-2xl font-semibold tracking-tight text-zinc-950"
            >
              Blog
            </h1>
            <p class="text-zinc-500 text-xs sm:text-sm">
              All posts, newest first.
            </p>
          </div>
          {
            posts.length > 0 ? (
              <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                {posts.map((post) => (
                  <BlogCard post={post} />
                ))}
              </div>
            ) : (
              <p class="text-xs sm:text-sm text-zinc-500 leading-relaxed">
                No posts yet. Add a file in{" "}
                <code class="font-mono text-zinc-900">src/content/blog/</code>{" "}
                and it will show up here.
              </p>
            )
          }
        </div>
      </section>
    </main>
    <Footer page={page} profile={profile} />
  </body>
</html>
