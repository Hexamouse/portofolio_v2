---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PagePreloader from "../../components/PagePreloader.astro";
import { getCollection, render } from "astro:content";
import { profile } from "../../data/portfolio";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, banner, bannerAlt, tags } = post.data;

const page = "w-full md:w-[80%] mx-auto";
const container = `${page} px-4 sm:px-6 md:px-8`;
const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | dzikri</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("theme") || "dark";
      document.documentElement.dataset.theme = savedTheme;
    </script>
  </head>
  <body
    class="bg-white text-zinc-950 antialiased selection:bg-zinc-900 selection:text-white font-sans"
  >
    <PagePreloader />
    <div
      aria-hidden="true"
      class="page-line pointer-events-none fixed inset-y-0 left-[10%] w-px bg-zinc-200 z-60"
    ></div>
    <div
      aria-hidden="true"
      class="page-line pointer-events-none fixed inset-y-0 right-[10%] w-px bg-zinc-200 z-60"
    ></div>
    <Header container={container} activeNav="blog" />
    <main>
      <article class={`${page} border-b border-zinc-200`}>
        <div class="px-6 sm:px-8 py-8 sm:py-10 space-y-6">
          <a
            href="/blog"
            class="inline-flex items-center gap-1 text-xs sm:text-sm font-medium text-zinc-600 hover:text-zinc-950 transition-colors"
          >
            <span aria-hidden="true">&larr;</span> All posts
          </a>
          <header class="space-y-3">
            <p class="text-[11px] sm:text-xs text-zinc-500">{formattedDate}</p>
            <h1
              class="text-2xl sm:text-4xl font-bold tracking-tight text-zinc-950 leading-tight"
            >
              {title}
            </h1>
            <p class="text-sm sm:text-base text-zinc-500 leading-relaxed">
              {description}
            </p>
            {
              tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5">
                  {tags.map((tag) => (
                    <span class="text-[10px] sm:text-[11px] font-mono px-2 py-0.5 bg-zinc-100 text-zinc-600 border border-zinc-200/70">
                      {tag}
                    </span>
                  ))}
                </div>
              )
            }
          </header>
          {
            banner && (
              <img
                src={banner}
                alt={bannerAlt ?? title}
                class="w-full aspect-[16/9] object-cover border border-zinc-200"
              />
            )
          }
          <div class="blog-content max-w-none">
            <Content />
          </div>
        </div>
      </article>
    </main>
    <Footer page={page} profile={profile} />
  </body>
</html>

<style>
  /* Minimal article styling (no typography plugin installed). */
  .blog-content {
    color: #52525b;
    font-size: 0.95rem;
    line-height: 1.7;
    display: grid;
    gap: 1.25rem;
  }
  .blog-content h2 {
    color: #09090b;
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-top: 1rem;
  }
  .blog-content h3 {
    color: #09090b;
    font-size: 1.1rem;
    font-weight: 700;
    margin-top: 0.5rem;
  }
  .blog-content a {
    color: #09090b;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .blog-content code {
    font-family: ui-monospace, monospace;
    font-size: 0.85em;
    background: #f4f4f5;
    border: 1px solid #e4e4e7;
    padding: 0.1rem 0.35rem;
  }
  .blog-content pre {
    background: #09090b;
    color: #fafafa;
    padding: 1rem;
    overflow-x: auto;
  }
  .blog-content pre code {
    background: transparent;
    border: 0;
    padding: 0;
    color: inherit;
  }
  .blog-content ul {
    padding-left: 1.35rem;
    list-style-type: disc;
    display: grid;
    gap: 0.4rem;
  }
  .blog-content img {
    border: 1px solid #e4e4e7;
    width: 100%;
  }
  html[data-theme="dark"] .blog-content {
    color: #a1a1aa;
  }
  html[data-theme="dark"] .blog-content h2,
  html[data-theme="dark"] .blog-content h3,
  html[data-theme="dark"] .blog-content a {
    color: #fafafa;
  }
  html[data-theme="dark"] .blog-content code {
    background: #18181b;
    border-color: #27272a;
  }
  html[data-theme="dark"] .blog-content img {
    border-color: #27272a;
  }
</style>
