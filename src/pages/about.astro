---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PagePreloader from "../components/PagePreloader.astro";
import ProfileHero from "../components/ProfileHero.astro";
import AboutBiography from "../components/AboutBiography.astro";
import AboutFocus from "../components/AboutFocus.astro";
import EducationSection from "../components/EducationSection.astro";
import OrganizationSection from "../components/OrganizationSection.astro";
import GalleryModal from "../components/GalleryModal.astro";
import { profile, aboutContent, interests, education, organizations } from "../data/portfolio";

const page = "w-full md:w-[80%] mx-auto";
const container = `${page} px-4 sm:px-6 md:px-8`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fahmiad.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="image" href="https://fahmiad.com/wp-content/uploads/2022/01/foto-profil-wa-sad-boy1.jpg" fetchpriority="high" />
    <title>About | dzikri</title>
    <script is:inline>const savedTheme = localStorage.getItem("theme") || "dark"; document.documentElement.dataset.theme = savedTheme;</script>
  </head>
  <body class="bg-white text-zinc-950 antialiased selection:bg-zinc-900 selection:text-white font-sans">
    <PagePreloader />
    <div aria-hidden="true" class="page-line pointer-events-none fixed inset-y-0 left-[10%] w-px bg-zinc-200 z-60"></div>
    <div aria-hidden="true" class="page-line pointer-events-none fixed inset-y-0 right-[10%] w-px bg-zinc-200 z-60"></div>
    <Header container={container} activeNav="about" />
    <main>
      <ProfileHero profile={profile} greeting="About Me" fetchPriority="high" />
      <AboutBiography page={page} content={aboutContent} />
      <AboutFocus page={page} interests={interests} />
      <EducationSection page={page} education={education} />
      <OrganizationSection page={page} organizations={organizations} />
    </main>
    <GalleryModal organizations={organizations} />
    <Footer page={page} profile={profile} />
  </body>
</html>
