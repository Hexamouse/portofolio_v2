---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PagePreloader from "../components/PagePreloader.astro";
import ProfileHero from "../components/ProfileHero.astro";
import HomeExperience from "../components/HomeExperience.astro";
import EducationSection from "../components/EducationSection.astro";
import HomeProjects from "../components/HomeProjects.astro";
import HomeSkills from "../components/HomeSkills.astro";
import BlogSection from "../components/BlogSection.astro";
import ContactSection from "../components/ContactSection.astro";
import { profile, projects, experiences, education, techRow1, techRow2 } from "../data/portfolio";

const page = "w-full md:w-[80%] mx-auto";
const container = `${page} px-4 sm:px-6 md:px-8`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fahmiad.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="image" href="https://fahmiad.com/wp-content/uploads/2022/01/foto-profil-wa-sad-boy1.jpg" fetchpriority="high" />
    <title>Home | dzikri</title>
    <script is:inline>const savedTheme = localStorage.getItem("theme") || "dark"; document.documentElement.dataset.theme = savedTheme;</script>
  </head>
  <body class="bg-white text-zinc-950 antialiased selection:bg-zinc-900 selection:text-white font-sans">
    <PagePreloader />
    <div aria-hidden="true" class="page-line pointer-events-none fixed inset-y-0 left-[10%] w-px bg-zinc-200 z-60"></div>
    <div aria-hidden="true" class="page-line pointer-events-none fixed inset-y-0 right-[10%] w-px bg-zinc-200 z-60"></div>
    <Header container={container} />
    <main>
      <ProfileHero profile={profile} greeting="Hi there, I'm Dzikri" fetchPriority="high" />
      <HomeExperience page={page} experiences={experiences} />
      <EducationSection page={page} education={education} />
      <HomeProjects page={page} projects={projects} github={profile.github} />
      <HomeSkills page={page} techRow1={techRow1} techRow2={techRow2} />
      <BlogSection page={page} />
      <ContactSection page={page} profile={profile} />
    </main>
    <Footer page={page} profile={profile} />
  </body>

  <style is:global>
    .tech-marquee-wrapper { display: flex; flex-direction: column; gap: 0.85rem; overflow: hidden; position: relative; width: 100%; padding: 0.35rem 0; mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%); }
    .tech-marquee-track, .tech-marquee-track-reverse { display: flex; width: max-content; flex-shrink: 0; will-change: transform; }
    .tech-marquee-track { animation: techMarqueeLeft 55s linear infinite !important; }
    .tech-marquee-track-reverse { animation: techMarqueeRight 55s linear infinite !important; }
    .tech-marquee-track:hover, .tech-marquee-track-reverse:hover { animation-play-state: paused; }
    .tech-marquee-group { display: flex; align-items: center; gap: 0.75rem; padding-right: 0.75rem; flex-shrink: 0; }
    @keyframes techMarqueeLeft { 0% { transform: translate3d(0, 0, 0); } 100% { transform: translate3d(-50%, 0, 0); } }
    @keyframes techMarqueeRight { 0% { transform: translate3d(-50%, 0, 0); } 100% { transform: translate3d(0, 0, 0); } }
  </style>
</html>
